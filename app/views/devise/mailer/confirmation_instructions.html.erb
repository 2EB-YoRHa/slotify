<!DOCTYPE html>
<html>
  <body style="font-family: Arial, sans-serif; background: #f8fafc; padding: 32px;">
    <div style="max-width: 600px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden;">
      <div style="background: #ecfeff; border-bottom: 1px solid #cffafe; padding: 32px;">
        <div style="display: inline-block; background: #22d3ee; color: #ffffff; border-radius: 999px; padding: 8px 14px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: .04em;">
          Slotify Security
        </div>

        <h1 style="margin: 20px 0 0; color: #0f172a; font-size: 28px; line-height: 1.2;">
          Confirm your email address
        </h1>

        <p style="margin: 12px 0 0; color: #475569; line-height: 1.6;">
          Finish setting up your Slotify account by confirming that this email belongs to you.
        </p>
      </div>

      <div style="padding: 32px;">
        <p style="color: #475569; line-height: 1.6; margin-top: 0;">
          Hello <strong><%= @resource.email %></strong>,
        </p>

        <% if @resource.try(:unconfirmed_email).present? %>
          <p style="color: #475569; line-height: 1.6;">
            You requested to change the email address on your Slotify account.
            Confirm the new address using the button below.
          </p>
        <% else %>
          <p style="color: #475569; line-height: 1.6;">
            Welcome to Slotify. Please confirm your email before signing in.
            This helps keep your account and organization workspace protected.
          </p>
        <% end %>

        <p style="margin: 32px 0;">
          <a
            href="<%= confirmation_url(@resource, confirmation_token: @token) %>"
            style="background: #22d3ee; color: white; text-decoration: none; padding: 14px 22px; border-radius: 10px; font-weight: bold; display: inline-block;"
          >
            Confirm Email
          </a>
        </p>

        <p style="color: #475569; line-height: 1.6;">
          If the button does not work, copy and paste this link into your browser:
        </p>

        <p style="word-break: break-all; color: #0891b2; font-size: 14px;">
          <%= confirmation_url(@resource, confirmation_token: @token) %>
        </p>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px; margin-top: 28px;">
          <p style="margin: 0; color: #0f172a; font-weight: bold;">
            Security note
          </p>

          <p style="margin: 8px 0 0; color: #64748b; font-size: 14px; line-height: 1.6;">
            If you did not create or update a Slotify account, you can safely ignore this email.
          </p>
        </div>

        <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 32px 0;">

        <p style="color: #94a3b8; font-size: 12px; line-height: 1.6; margin: 0;">
          This confirmation link is time-limited for your security.
        </p>
      </div>
    </div>
  </body>
</html>